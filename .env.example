# Copie para .env no ambiente local. Na Vercel, cadastre os mesmos nomes
# em Settings → Environment Variables. Não commite o arquivo .env.

SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=chave-publica-anon
# A service_role fica só no servidor, se uma rotina privilegiada for necessária.
# Não coloque essa chave em JavaScript, no bundle ou neste exemplo com valor real.
SUPABASE_SERVICE_ROLE=

APP_URL=https://seu-dominio.vercel.app

# Segredo do webhook já existente em Configurações. Troque antes de publicar.
# WEBHOOK_SECRET=troque-este-valor

# UAZAPI / Comunicador (token permanente — não commitar valor real)
UAZAPI_ADMIN_TOKEN=
UAZAPI_CREATE_INSTANCE_URL=https://SEU-PROJETO.supabase.co/functions/v1/create-instance-url
# Em desenvolvimento local no Windows, se o cURL falhar por certificado SSL: UAZAPI_SSL_VERIFY=0

# Futuro Cloudflare Turnstile. Deixe vazio até a integração.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
