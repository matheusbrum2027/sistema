# Copie para .env no ambiente local. Na Vercel, cadastre os mesmos nomes
# em Settings → Environment Variables. Não commite o arquivo .env.

SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=chave-publica-anon
# A service_role fica só no servidor, se uma rotina privilegiada for necessária.
# Não coloque essa chave em JavaScript, no bundle ou neste exemplo com valor real.
SUPABASE_SERVICE_ROLE=

APP_URL=https://seu-dominio.vercel.app

# Persistência privada do painel. Gere segredos longos e diferentes.
FLN_SEGREDO=troque-por-um-segredo-de-no-minimo-32-caracteres
FLN_CRON=troque-por-um-segredo-de-cron
FLN_BASE=1

# Google Drive — backup diário (OAuth, um clique no painel).
# URI de redirecionamento: {APP_URL}/index.php?drive=oauth
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# Chave de API do mesmo projeto. O sistema envia key= no servidor. Não commitar o valor.
# GOOGLE_API_KEY=

# Logs estruturados de tempo/bytes no servidor. Deixe 0 normalmente.
FLN_PERF_LOG=0

# Segredo do webhook já existente em Configurações. Troque antes de publicar.
# WEBHOOK_SECRET=troque-este-valor

# OpenAI — atendimento automático pós-comunicação (só reserva vinculada).
# Também pode ser salva no chat (Configurações). Não commitar valor real.
# OPENAI_API_KEY=sk-...

# UAZAPI / Comunicador (token permanente — não commitar valor real)
UAZAPI_ADMIN_TOKEN=
UAZAPI_CREATE_INSTANCE_URL=https://SEU-PROJETO.supabase.co/functions/v1/create-instance-url
# Em desenvolvimento local no Windows, se o cURL falhar por certificado SSL: UAZAPI_SSL_VERIFY=0

# Futuro Cloudflare Turnstile. Deixe vazio até a integração.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
