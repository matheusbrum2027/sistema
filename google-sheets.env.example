# Google Sheets — espelho automático do painel
# 1) Crie projeto no Google Cloud, ative Sheets API + Drive API
# 2) Conta de serviço → chaves → JSON
# 3) No PowerShell (substitua o caminho do JSON):
#    [Convert]::ToBase64String([IO.File]::ReadAllBytes("C:\caminho\conta-servico.json")) | Set-Clipboard
# 4) Cole em GOOGLE_SERVICE_ACCOUNT_B64 (uma linha, sem quebras)

GOOGLE_SHEETS_ENABLED=1
GOOGLE_SERVICE_ACCOUNT_B64=
# Opcional: ID da pasta do Drive (compartilhe a pasta com o e-mail da conta de serviço, permissão Editor)
GOOGLE_SHEETS_FOLDER_ID=
